NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Número de proxies de confianza (Nginx = 1). 0 en desarrollo directo.
TRUST_PROXY=0

# false: solo /health (sin MySQL). true: identidad, documentos, auditoría.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=securedocs_app
DB_PASSWORD=
DB_NAME=securedocs

# Alta pública: open (rol reader) | closed (solo un admin crea cuentas).
REGISTRATION_MODE=open
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
# true obligatorio con HTTPS; en producción se exige true.
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# Fuera de directorios públicos. Relativo a backend/ (raíz/storage está en .gitignore).
STORAGE_DIR=../storage/documents
UPLOAD_MAX_BYTES=10485760

# Claves (base64 de 32 bytes, distintas entre sí). Generar con:
#   npm run keys:generate -w backend
# Alternativa: VAR_FILE=ruta a un archivo con la clave (secretos de Docker).
# Nunca subirlas al repositorio ni reutilizarlas entre entornos.
DOCUMENT_KEK_ID=k1
DOCUMENT_KEK=
# Rotación: claves anteriores solo para descifrar, "id:base64,id2:base64".
DOCUMENT_KEK_PREVIOUS=
MFA_ENCRYPTION_KEY=
CSRF_SECRET=
