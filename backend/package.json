{
  "name": "@securedocs/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:run:prod": "typeorm -d dist/database/data-source.js migration:run",
    "keys:generate": "ts-node src/scripts/generate-keys.ts",
    "admin:create": "ts-node src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "^11.0.0",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "joi": "^18.0.0",
    "mysql2": "^3.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "mysql-memory-server": "1.18.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
