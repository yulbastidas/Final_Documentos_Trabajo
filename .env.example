# Copiar a .env y completar localmente. Nunca versionar valores reales.
MYSQL_DATABASE=securedocs
MYSQL_USER=securedocs_app
HTTP_PORT=8080
# Origen único que abrirá el navegador. Usa https con infra/compose.https.yaml.
PUBLIC_ORIGIN=http://localhost:8080
# true solo cuando el proxy HTTPS está activo.
COOKIE_SECURE=false
# ID estable para la clave documental local.
DOCUMENT_KEK_ID=k1
